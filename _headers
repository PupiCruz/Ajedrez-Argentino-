# Ajedrez Argentino — Cache-Control headers
# Netlify y Cloudflare Pages leen este archivo automáticamente.
#
# index.html y todos los datos: "no-cache" = el navegador SIEMPRE pregunta al servidor
# si hubo cambios antes de usar la copia guardada. Si no hubo cambios → respuesta 304
# instantánea (no re-descarga). Si hubo cambios → baja la versión nueva.
# Esto garantiza que los visitantes siempre vean la ronda actualizada.

/index.html
  Cache-Control: no-cache, must-revalidate

/data/manifest.js
  Cache-Control: no-cache, must-revalidate

/data/embedded-photos.js
  Cache-Control: no-cache, must-revalidate

/data/games_0.json
  Cache-Control: no-cache, must-revalidate

/data/games_1.json
  Cache-Control: no-cache, must-revalidate

/data/book.json
  Cache-Control: no-cache, must-revalidate

/data/t/*
  Cache-Control: no-cache, must-revalidate

/data/p/*
  Cache-Control: no-cache, must-revalidate

# Assets (Stockfish, piezas SVG, sonidos, chess.js): nunca cambian entre versiones,
# se pueden cachear 1 año sin problema.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
